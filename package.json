{
  "name": "markdown-preview-basic",
  "displayName": "Markdown Preview Basic",
  "description": "Custom-styled markdown preview, available via Open With...",
  "version": "0.0.3",
  "publisher": "juji",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/juji/vscode-markdown-preview-basic.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "npx @vscode/vsce package",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownPreviewBasic.preview",
        "displayName": "Markdown Preview (Basic)",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mathjax": "^3.2.2",
    "mermaid": "^11.16.0",
    "shiki": "^4.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
